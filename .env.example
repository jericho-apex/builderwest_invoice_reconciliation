# Builderwest Invoice Matching & Reconciliation — environment variables
#
# Copy this file to .env for local development. NEVER commit a real .env file
# or paste real secrets into this file, chat, or a PR — .gitignore already
# excludes .env, but treat that as a backstop, not the plan.
#
# There is no Prime sandbox for this pilot. PRIME_BASE_URL always points at
# production. PRIME_DRY_RUN and PRIME_TEST_WORK_ORDER_ID exist specifically to
# make that safe during development — see README.md before touching either.
#
# Real production values (once this project is promoted) live in Render's
# environment/secret store for the deployed service — never here, never in
# plaintext email, never in Slack. Share credentials only via a secure channel
# (password manager, call, or IT's secure transfer process).

# ---------------------------------------------------------------------------
# Prime Ecosystem API
# ---------------------------------------------------------------------------
# Production base URL (no sandbox tier exists for this pilot).
PRIME_BASE_URL=https://www.primeeco.tech/api.prime/v2

# OAuth2 password grant, issued by Prime (the vendor) and linked to a
# dedicated integration user - never a staff login.
PRIME_CLIENT_ID=
PRIME_CLIENT_SECRET=
PRIME_USERNAME=
PRIME_PASSWORD=

# When true, the pipeline runs matching + decision logic and logs exactly
# what it WOULD do (attachment upload, AP invoice creation, approval, isSynced
# poll) without calling any Prime write endpoint. Keep this "true" until the
# dry-run output has been manually reviewed for a batch of synthetic cases -
# see the plan's build sequence, step 7.
PRIME_DRY_RUN=true

# A dedicated, clearly-labeled dummy/test work order in PRODUCTION Prime,
# used once PRIME_DRY_RUN=false for live write-path testing (build sequence
# step 9). Requires written authorization from Builderwest/Prime first, plus
# an agreed process for cleaning up test invoices afterward. Never point this
# at a real customer work order.
PRIME_TEST_WORK_ORDER_ID=

# Which queryable work-order field holds the purchase order number printed on
# a supplier invoice (e.g. "PO21266" on the client's dummy invoices). This is
# the ONLY identifier work-order matching uses - the job number is shared
# across every work order on a job and so cannot identify one.
#
# UNCONFIRMED: Prime's v2 docs list no PO field (docs/prime-api-gaps.md Q1).
# Kept as config so the vendor's answer needs no code change. Fails safe - a
# wrong field name returns zero matches and routes to Exceptions/No work order,
# it never mismatches.
PRIME_WORK_ORDER_PO_FIELD=label

# Cost matching tolerance (client business decision, PRD §8.3/§9 - currently
# "exact", tightest setting; loosen later without a code change).
#   mode  = exact | dollar | percentage
#   value = only used when mode is "dollar" or "percentage"
COST_TOLERANCE_MODE=exact
COST_TOLERANCE_VALUE=0

# Which Prime work-order field is the authoritative cost figure to compare
# against (PRD §9.6 is still open with the client - kept as config so
# resolving it later needs no code change).
#   field = cost | costTaxTotal
COST_FIELD=costTaxTotal

# ---------------------------------------------------------------------------
# Microsoft Graph (Outlook / Microsoft 365)
# ---------------------------------------------------------------------------
# App-only / client-credentials auth - the worker never uses a human mailbox
# login. Requires Mail.ReadWrite (Mail.Send only if GRAPH_SEND_MAIL_ENABLED),
# scoped via an Exchange application access policy to GRAPH_MAILBOX_ADDRESS.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# The invoice mailbox to poll. During this pilot, a test mailbox inside
# Builderwest's own M365 tenant, populated only with synthetic/augmented
# sample invoices - never real client data (PRD §9.1 - the real production
# address, accounts@ vs purchaseorders@, is still open with the client).
GRAPH_MAILBOX_ADDRESS=
# Enable the ONE auto-reply case: a detected invoice with missing/incomplete
# extracted data gets a reply asking the sender to resend/complete it. Off by
# default - requires Mail.Send + admin consent, and GRAPH_TEST_RECIPIENT set
# before enabling.
GRAPH_SEND_MAIL_ENABLED=false

# A safe internal address to send test outbound emails to, so the auto-reply
# path can be exercised without emailing a real trade contact.
GRAPH_TEST_RECIPIENT=
# ---------------------------------------------------------------------------
# OpenRouter (AI extraction + classification, targeting a Claude model)
# ---------------------------------------------------------------------------
# Used for both dev and production per the explicit decision on this project.
# Before production cutover, confirm the OpenRouter account's data-retention /
# training-use settings are locked down (see README.md).
OPENROUTER_API_KEY=
# Verify the exact current model slug against OpenRouter's model list before
# relying on this value - e.g. "anthropic/claude-sonnet-4.5" as of this
# writing, but OpenRouter's naming can change.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------------------
# Worker behavior
# ---------------------------------------------------------------------------
# How often the poll -> enqueue -> drain tick runs.
POLL_INTERVAL_MINUTES=10

# SQLite database file path. On Render this must point at a path on the
# attached persistent disk (see README.md) - never ephemeral container storage.
DB_PATH=./data/app.db

LOG_LEVEL=info
