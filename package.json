{
  "name": "builderwest-invoice-reconciliation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 pilot: automated trade invoice matching & reconciliation for Builderwest (Prime Ecosystem -> Xero).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.local dist/worker/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "extract:sample": "tsx --env-file-if-exists=.env.local scripts/extract-sample.ts",
    "pipeline:sample": "tsx --env-file-if-exists=.env.local scripts/pipeline-sample.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
